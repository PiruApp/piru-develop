# Copiá este archivo como .env.local y completá los valores. .env.local no se sube al repo.

# --- Backend Spring Boot ---
# URL pública (la usa el navegador para circuitos, puntos y cotizaciones)
NEXT_PUBLIC_API_URL=http://localhost:8080
# Clave compartida con el backend para las rutas de usuarios. Debe ser IGUAL a PIRU_BFF_CLAVE del backend.
# En desarrollo el backend usa por defecto: clave-local-de-desarrollo-cambiar
PIRU_BFF_CLAVE=clave-local-de-desarrollo-cambiar

# --- Login (Auth.js) ---
# Generala con: npx auth secret   (o cualquier texto largo y aleatorio)
AUTH_SECRET=
# Opcional: login con Google. Crealos en Google Cloud Console > APIs y servicios > Credenciales >
# ID de cliente OAuth (aplicación web). URI de redirección: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Base local de usuarios (SQLite). Se crea sola.
PIRU_DB_PATH=.data/piru.db
